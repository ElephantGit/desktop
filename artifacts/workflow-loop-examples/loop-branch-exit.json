        "agentConfig": {
          "schemaVersion": 3,
          "executor": {
            "agentCli": "official/ora-space.codeagentcli",
            "modelId": "gpt-5"
          },
          "roleId": "Implementer",
          "skills": [],
          "mcps": [],
          "prompt": "当前轮次：{{#review-loop.round#}}\n只输出当前轮次加 1 后的数字。例如输入 1 输出 2。\n不要输出其他文字、标点或 Markdown，不要调用工具。",
          "interactive": false
        }
      },
      "parentId": "review-loop"
    },
    {
      "id": "summary",
      "type": "workflow",
      "position": {
        "x": 2230,
        "y": 310
      },
      "data": {
        "kind": "agent",
        "title": "Agent D：整理结果",
        "description": "",
        "agentConfig": {
          "schemaVersion": 3,
          "executor": {
            "agentCli": "official/ora-space.codeagentcli",
            "modelId": "gpt-5"
          },
          "roleId": "Implementer",
          "skills": [],
          "mcps": [],
          "prompt": "请原样整理以下结果，不要重新评审，不要调用工具：\n结束轮次：{{#review-loop.finishedRound#}}\n评审决定：{{#review-loop.decision#}}\n最终内容：{{#review-loop.finalDraft#}}\n按以上三行格式输出。",
          "interactive": false
